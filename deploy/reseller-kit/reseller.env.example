# ============================================================================
# reseller-kit 共享配置（复制为 reseller.env 后填写，chmod 600，切勿提交到 git）
# ----------------------------------------------------------------------------
# 这是「快接站」一键开通脚本的全局配置。每次开通副站都读取本文件。
# ============================================================================

# ---- 主站（你的现有 new-api）----
# 脚本从宿主机访问主站管理 API 的地址（主站 compose 默认把 3000 映射到宿主）
MAIN_API_URL="http://127.0.0.1:3000"
# 副站容器从 docker 内网访问主站的地址（= 主站容器 container_name + 端口，走内网不出公网）
MAIN_INTERNAL_URL="http://new-api:3000"
# 主站管理员账号（role>=10，脚本用它建批发账户/改分组倍率）。建议用专用管理员，不要用 root。
MAIN_ADMIN_USER="admin"
MAIN_ADMIN_PASS="change-me"

# ---- docker / 网络 ----
# 主站所在的 docker 网络名（副站要加入它才能用内网访问主站；Caddy 也在此网络）
# 查看：docker inspect new-api --format '{{json .NetworkSettings.Networks}}'
SHARED_NETWORK="newapi_default"
# new-api 镜像（与主站保持一致，确保版本统一）
NEWAPI_IMAGE="calciumion/new-api:latest"
# 各副站数据目录的父目录（每个副站一个子目录，含独立 DB / 日志 / site.env）
RESELLERS_DIR="/opt/newapi-resellers"
# 副站对宿主暴露端口的分配区间（仅绑定 127.0.0.1，不对公网开放）
PORT_RANGE_START="3101"
PORT_RANGE_END="3999"
TZ="Asia/Shanghai"

# ---- 反向代理 ----
# 子域名 HTTPS 用哪种反代：nginx | caddy | none
PROXY_KIND="nginx"

# -- nginx（PROXY_KIND=nginx 时用）--
# nginx 站点配置目录（脚本在此写入 <子域名>.conf）。Debian/Ubuntu 常见 /etc/nginx/conf.d
NGINX_SITES_DIR="/etc/nginx/conf.d"
NGINX_RELOAD_CMD="nginx -t && systemctl reload nginx"
# 通配证书（推荐：一张 *.你的域名.com 覆盖所有副站；用 certbot DNS-01 申请，见 README）
TLS_CERT="/etc/letsencrypt/live/你的域名.com/fullchain.pem"
TLS_KEY="/etc/letsencrypt/live/你的域名.com/privkey.pem"

# -- caddy（PROXY_KIND=caddy 时用）--
CADDY_SITES_DIR="/etc/caddy/sites"
CADDY_RELOAD_CMD="systemctl reload caddy"

# ---- 批发计费 ----
# 共享批发分组名。【一次性设置】把这个分组加到主站要给代理商用的上游渠道的「分组」里，
# 否则批发请求按此分组选不到渠道。脚本会确保该分组的 group_ratio 存在。
DEFAULT_WHOLESALE_GROUP="reseller_wholesale"
# 默认批发折扣倍率（0.7 = 批发七折，主站赚 3 成差价）。开通时可用第 3 个参数覆盖。
DEFAULT_WHOLESALE_RATIO="0.7"
# 默认预付批发额度（美元）。开通时可用第 4 个参数覆盖。500000 quota = 1 美元。
DEFAULT_PREPAID_USD="10"

# ---- 模型 ----
# 允许代理商转售的模型（逗号分隔）。同时用于：批发令牌的 model_limits + 副站回指渠道的 models。
# 务必与主站实际提供且批发分组渠道支持的模型一致。
MODELS="gpt-4o,gpt-4o-mini,claude-3-5-sonnet-20241022,gpt-4.1"
